# ==============================================================================
# Job Hunt Orchestrator - Environment Configuration Template
# Copy this file to .env and populate with your personal credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Job Portals (Module 1: Algorithmic Freshness & Module 5: Auto-Apply)
# ------------------------------------------------------------------------------
NAUKRI_USERNAME=your_naukri_email@example.com
NAUKRI_PASSWORD=your_naukri_secure_password

BAYT_USERNAME=your_bayt_email@example.com
BAYT_PASSWORD=your_bayt_secure_password

# Headless Browser Settings
HEADLESS=true
BROWSER_TIMEOUT_MS=45000
STEALTH_MODE=true
SESSIONS_DIR=./sessions

# Freshness Cron Settings (Gulf Timezone: 10 AM - 1 PM GST)
GULF_CRON_ENABLED=true
GULF_WINDOW_START_HOUR=10
GULF_WINDOW_END_HOUR=13
DEFAULT_TIMEZONE=Asia/Kolkata
GULF_TIMEZONE=Asia/Dubai

# ------------------------------------------------------------------------------
# 2. Lead Generation & CRM (Module 2: Apollo / Hunter / Google Sheets)
# ------------------------------------------------------------------------------
APOLLO_API_KEY=your_apollo_api_key_here
HUNTER_API_KEY=your_hunter_api_key_here

# Google Sheets CRM
# Path to service account JSON (recommended) or OAuth client secret
GOOGLE_APPLICATION_CREDENTIALS=./config/google_service_account.json
GOOGLE_SHEETS_SPREADSHEET_ID=your_google_sheets_spreadsheet_id_here
GOOGLE_SHEETS_RANGE=Leads!A:I

# Gmail API (Module 4: Draft Creation)
GMAIL_USER_EMAIL=your_email@gmail.com
GMAIL_CLIENT_SECRET_FILE=./config/gmail_client_secret.json

# ------------------------------------------------------------------------------
# 3. LLM Engine (Tiered Architecture: Local Ollama -> Groq -> Gemini)
# ------------------------------------------------------------------------------
# Tier 1: Local Ollama (Private & Cost-Free)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_TEMPERATURE=0.2

# Tier 2: Groq Cloud Fallback (Ultra-fast Llama 3.3)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Tier 3: Google Gemini API Fallback
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 4. ChromaDB & Vector Storage (Module 3 & Module 4 RAG)
# ------------------------------------------------------------------------------
CHROMA_PERSIST_DIR=./data/chroma_db

# ------------------------------------------------------------------------------
# 5. Fallback Webhooks & Alerts (Discord / Slack)
# ------------------------------------------------------------------------------
FALLBACK_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook/here
